# 依赖与构建产物
node_modules/
.pnpm-store/
dist/
*.tsbuildinfo
*.log

# 构建产物（源码在 src/，发布内容由构建生成（tsc + bundle-host），不入库）
packages/*/lib/
packages/*/shared/
packages/*/types/
packages/*/LICENSE
packages/*/.index.bundle.js

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
coverage/
.stryker-tmp/
.maintenance-drafts/

# codegraph 本地索引（每 worktree 独立，不入库；任务结束随目录清理）
.codegraph/

# 测试运行时污染兜底（#218）：DSH_HOME 未正确注入时产生的 undefined 路径与历史数据
packages/*/undefined/
**/*.jsonl

# Mimosa 钩子会话状态（本地工具运行时产物，不入库）
.mimosa/

# peerfix / 重装类脚本留下的「改动前备份」（如 pin-desktop-peers-to-host.mjs 的 .bak-peerpin-<ts>），
# 只在本机有参考价值，不入库；已归档的旧备份见 _archive/2026-09/2026-09-20_dirty-worktree-cleanup/03_备份/
*.bak-*

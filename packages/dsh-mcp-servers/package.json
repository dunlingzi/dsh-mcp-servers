{
  "name": "@dunlingzi/dsh-mcp-servers",
  "version": "0.1.1",
  "description": "DSH MCP 服务器管理插件：设置页「MCP 服务器」入口，面板按状态分级展示 MCP 服务器（运行中/连接中/未连接/失败），支持新增/编辑/启停/删除与单次探活（stdio / streamable-http 表单 + 粘贴 mcpServers JSON 导入）。已连接服务器的工具以 mcp__<server>__<tool> 注册给模型直接调用；项目级默认经中间层 ws_mcp_* 四原子工具收敛模型面。",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "node ../../scripts/build/clean-lib.ts && tsc -p tsconfig.json && node ../../scripts/build/bundle-host.ts .",
    "test": "node ../../scripts/test/run-vitest.mjs --min 16",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm run build && pnpm test"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "bannerJs": "import { createRequire as __mcpServersRequire } from \"node:module\";\nconst require = __mcpServersRequire(import.meta.url);"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "shared/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@deepseek-ai/dsh-host-webserver": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-system-prompt": "catalog:",
    "@deepseek-ai/dsh-tools": "catalog:",
    "schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-rc.2 || ^0.1.6-alpha.1",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2 || ^0.1.6-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2 || ^0.1.6-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.2 || ^0.1.6-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dunlingzi/dsh-mcp-servers.git",
    "directory": "packages/dsh-mcp-servers"
  },
  "bugs": {
    "url": "https://github.com/dunlingzi/dsh-mcp-servers/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "mcp",
    "model-context-protocol"
  ],
  "author": "dunlingzi",
  "publishConfig": {
    "access": "public"
  }
}

{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "packages/dsh-mcp-servers/src/index.ts",
    "packages/dsh-mcp-servers/src/workspace/**/*.ts",
    "packages/dsh-mcp-servers/src/config/model/**/*.ts",
    "!packages/dsh-mcp-servers/src/client/**",
    "!packages/dsh-mcp-servers/src/types/**",
    "!packages/dsh-mcp-servers/src/integration/**",
    "!packages/dsh-mcp-servers/src/**/interface.ts"
  ],
  "testRunner": "vitest",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayLiteral",
      "ObjectLiteral",
      "TemplateLiteral"
    ]
  },
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "concurrency": 16,
  "timeoutMS": 60000,
  "dryRunTimeoutMinutes": 5,
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "vitest": {
    "related": false,
    "configFile": "vitest.stryker.d/dsh-mcp-servers.config.ts"
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/dsh-mcp-servers-entry.json"
  },
  "incremental": true,
  "incrementalFile": "coverage/mutation/incremental-mcp-servers-entry.json",
  "_comment": "entry——index+workspace（工作空间路由域）+config/model（归一化/导入/schema）；types/integration（type-only）显式排除；测试全套跑（perTest 关联）；incremental 基线随 observe 班次重建。"
}
